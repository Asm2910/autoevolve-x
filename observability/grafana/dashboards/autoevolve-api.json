{
    "uid": "autoevolve-api",
    "title": "AutoEvolve-X API",
    "description": "Traffic, speed, errors and the distribution of risk scores for the live scoring API.",
    "tags": ["autoevolve-x"],
    "timezone": "browser",
    "editable": false,
    "graphTooltip": 1,
    "schemaVersion": 41,
    "version": 1,
    "refresh": "10s",
    "time": {"from": "now-30m", "to": "now"},
    "templating": {"list": []},
    "annotations": {"list": []},
    "links": [],
    "panels": [
      {
        "id": 1, "type": "stat", "title": "Requests per second",
        "description": "All endpoints, averaged over the rate window.",
        "datasource": {"type": "prometheus", "uid": "prometheus"},
        "gridPos": {"x": 0, "y": 0, "w": 6, "h": 5},
        "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum(rate(api_requests_total[$__rate_interval]))", "legendFormat": "", "refId": "A"}],
        "fieldConfig": {"defaults": {"unit": "reqps", "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "text", "value": null}]}, "noValue": "no data", "decimals": 2}, "overrides": []},
        "options": {"colorMode": "none", "graphMode": "area", "justifyMode": "auto", "textMode": "value", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}}
      },
      {
        "id": 2, "type": "stat", "title": "Slowest 5% of predictions",
        "description": "95th percentile latency of /predict.",
        "datasource": {"type": "prometheus", "uid": "prometheus"},
        "gridPos": {"x": 6, "y": 0, "w": 6, "h": 5},
        "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "histogram_quantile(0.95, sum by (le) (rate(api_request_latency_seconds_bucket{path=\"/predict\"}[$__rate_interval])))", "legendFormat": "", "refId": "A"}],
        "fieldConfig": {"defaults": {"unit": "s", "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "text", "value": null}, {"color": "orange", "value": 0.3}, {"color": "red", "value": 0.5}]}, "noValue": "no data", "decimals": 3}, "overrides": []},
        "options": {"colorMode": "none", "graphMode": "area", "justifyMode": "auto", "textMode": "value", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}}
      },
      {
        "id": 3, "type": "stat", "title": "Server errors",
        "description": "Share of requests that ended in a 5xx response.",
        "datasource": {"type": "prometheus", "uid": "prometheus"},
        "gridPos": {"x": 12, "y": 0, "w": 6, "h": 5},
        "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "(sum(rate(api_requests_total{status_code=~\"5..\"}[$__rate_interval])) or vector(0)) / sum(rate(api_requests_total[$__rate_interval]))", "legendFormat": "", "refId": "A"}],
        "fieldConfig": {"defaults": {"unit": "percentunit", "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "text", "value": null}, {"color": "orange", "value": 0.01}, {"color": "red", "value": 0.05}]}, "noValue": "no data", "decimals": 2}, "overrides": []},
        "options": {"colorMode": "none", "graphMode": "area", "justifyMode": "auto", "textMode": "value", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}}
      },
      {
        "id": 4, "type": "stat", "title": "Flagged as risky",
        "description": "Share of scored subscribers at or above the decision threshold, over the selected time range.",
        "datasource": {"type": "prometheus", "uid": "prometheus"},
        "gridPos": {"x": 18, "y": 0, "w": 6, "h": 5},
        "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum(increase(predictions_total{prediction=\"1\"}[$__range])) / sum(increase(predictions_total[$__range]))", "legendFormat": "", "refId": "A", "instant": true}],
        "fieldConfig": {"defaults": {"unit": "percentunit", "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "text", "value": null}]}, "noValue": "no data", "decimals": 2}, "overrides": []},
        "options": {"colorMode": "none", "graphMode": "area", "justifyMode": "auto", "textMode": "value", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}}
      },
      {
        "id": 5, "type": "timeseries", "title": "Requests per second by endpoint",
        "description": "Unmatched means a URL the API does not have.",
        "datasource": {"type": "prometheus", "uid": "prometheus"},
        "gridPos": {"x": 0, "y": 5, "w": 12, "h": 8},
        "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum by (path) (rate(api_requests_total[$__rate_interval]))", "legendFormat": "{{path}}", "refId": "A"}],
        "fieldConfig": {"defaults": {"unit": "reqps", "color": {"mode": "palette-classic"}, "custom": {"lineWidth": 2, "fillOpacity": 8, "showPoints": "never", "spanNulls": false}, "noValue": "no data"}, "overrides": []},
        "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}}
      },
      {
        "id": 6, "type": "timeseries", "title": "Prediction latency", "description": "",
        "datasource": {"type": "prometheus", "uid": "prometheus"},
        "gridPos": {"x": 12, "y": 5, "w": 12, "h": 8},
        "targets": [
          {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "histogram_quantile(0.50, sum by (le) (rate(api_request_latency_seconds_bucket{path=\"/predict\"}[$__rate_interval])))", "legendFormat": "median", "refId": "A"},
          {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "histogram_quantile(0.95, sum by (le) (rate(api_request_latency_seconds_bucket{path=\"/predict\"}[$__rate_interval])))", "legendFormat": "95th percentile", "refId": "B"},
          {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "histogram_quantile(0.99, sum by (le) (rate(api_request_latency_seconds_bucket{path=\"/predict\"}[$__rate_interval])))", "legendFormat": "99th percentile", "refId": "C"}
        ],
        "fieldConfig": {"defaults": {"unit": "s", "color": {"mode": "palette-classic"}, "custom": {"lineWidth": 2, "fillOpacity": 8, "showPoints": "never", "spanNulls": false}, "noValue": "no data"}, "overrides": []},
        "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}}
      },
      {
        "id": 7, "type": "timeseries", "title": "Risk score over time",
        "description": "Where the middle and the top of the score distribution sit. A steady upward move across all three lines is the live signal of drift.",
        "datasource": {"type": "prometheus", "uid": "prometheus"},
        "gridPos": {"x": 0, "y": 13, "w": 12, "h": 8},
        "targets": [
          {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "histogram_quantile(0.50, sum by (le) (rate(prediction_score_bucket[$__rate_interval])))", "legendFormat": "median score", "refId": "A"},
          {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "histogram_quantile(0.90, sum by (le) (rate(prediction_score_bucket[$__rate_interval])))", "legendFormat": "90th percentile", "refId": "B"},
          {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "histogram_quantile(0.99, sum by (le) (rate(prediction_score_bucket[$__rate_interval])))", "legendFormat": "99th percentile", "refId": "C"}
        ],
        "fieldConfig": {"defaults": {"unit": "percentunit", "color": {"mode": "palette-classic"}, "custom": {"lineWidth": 2, "fillOpacity": 8, "showPoints": "never", "spanNulls": false}, "noValue": "no data", "max": 1, "min": 0}, "overrides": []},
        "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}}
      },
      {
        "id": 8, "type": "timeseries", "title": "Flagged share over time", "description": "",
        "datasource": {"type": "prometheus", "uid": "prometheus"},
        "gridPos": {"x": 12, "y": 13, "w": 12, "h": 8},
        "targets": [
          {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum(rate(predictions_total{prediction=\"1\"}[$__rate_interval])) / sum(rate(predictions_total[$__rate_interval]))", "legendFormat": "flagged", "refId": "A"},
          {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "(sum(rate(prediction_failures_total[$__rate_interval])) or vector(0)) / sum(rate(api_requests_total{path=\"/predict\"}[$__rate_interval]))", "legendFormat": "rejected requests", "refId": "B"}
        ],
        "fieldConfig": {"defaults": {"unit": "percentunit", "color": {"mode": "palette-classic"}, "custom": {"lineWidth": 2, "fillOpacity": 8, "showPoints": "never", "spanNulls": false}, "noValue": "no data"}, "overrides": []},
        "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}}
      },
      {
        "id": 9, "type": "heatmap", "title": "Risk score distribution",
        "description": "How many predictions fell in each score band, over time. Bands are dense near zero because fraud is rare.",
        "datasource": {"type": "prometheus", "uid": "prometheus"},
        "gridPos": {"x": 0, "y": 21, "w": 24, "h": 9},
        "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum by (le) (increase(prediction_score_bucket[$__rate_interval]))", "legendFormat": "{{le}}", "refId": "A", "format": "heatmap"}],
        "options": {
          "calculate": false, "cellGap": 1,
          "color": {"mode": "scheme", "scheme": "Blues", "fill": "dark-blue", "scale": "exponential", "exponent": 0.5, "steps": 64, "reverse": false},
          "yAxis": {"axisPlacement": "left", "unit": "short"},
          "rowsFrame": {"layout": "auto"},
          "tooltip": {"mode": "single", "yHistogram": false, "showColorScale": false},
          "legend": {"show": true}
        },
        "fieldConfig": {"defaults": {}, "overrides": []}
      }
    ]
  }