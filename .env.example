# Copy this file to .env and fill in the value. Never commit .env (it is git-ignored).
# Only needed for: python -m scripts.run_agent --proposer llm
ANTHROPIC_API_KEY=

# Optional: the Grafana admin password used by docker compose (default: admin)
# GRAFANA_ADMIN_PASSWORD=

# Optional: point the dashboard at a different memory database
# AUTOEVOLVE_MEMORY_DB=memory/autoevolve.db
